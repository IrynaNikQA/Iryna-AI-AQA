# =============================================================================
# Run tests (required to clone and run Playwright)
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Base URL of the Didaxis environment under test (no trailing slash).
DIDAXIS_URL=https://test.didaxis.studio

# Admin (or primary) account used by tests/auth.setup.ts to build storageState.
DIDAXIS_EMAIL=admin@example.com

# Password for DIDAXIS_EMAIL.
DIDAXIS_PASSWORD=your-password-here

# Bearer token for REST cleanup (DELETE /api/programs) and API helpers.
DIDAXIS_API_TOKEN=your-api-token-here

# Optional: secondary account for permission / role probes (non-admin flows).
DIDAXIS_ALT_EMAIL=viewer@example.com

# Optional: password for DIDAXIS_ALT_EMAIL.
DIDAXIS_ALT_PASSWORD=your-alt-password-here

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Used by the headless agent in .github/workflows/test-generation.yml and by
# Cursor MCP plugins (GitHub, Atlassian). Configure MCP tokens in Cursor Settings.
# =============================================================================

# Cursor API key for headless / cloud agent runs in CI.
CURSOR_API_KEY=cur_xxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian API token (https://id.atlassian.com/manage-profile/security/api-tokens).
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira / Confluence site URL (e.g. https://your-org.atlassian.net).
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com
